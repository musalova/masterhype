    "build:win": "electron-vite build && electron-builder --win --publish never",
    "release": "node scripts/release.mjs",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "tsc --noEmit && eslint . && vitest run",
    "build:android": "node scripts/build-android.mjs",
    "test:remote": "node scripts/test-remote.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "youtubei.js": "^17.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "bgutils-js": "^4.0.3",
    "electron": "^38.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^4.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "framer-motion": "^12.23.12",
    "globals": "17.13.0",
    "jintr": "^3.3.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.544.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.72.0",
    "vite": "^7.1.6",
    "vitest": "^3.2.4",
    "zustand": "^5.0.16"
  }
